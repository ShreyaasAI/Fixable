# Copy to web/.env.local (gitignored). These values end up in the browser bundle: only public
# values belong here (the Supabase anon/publishable key is public by design).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable or anon key>
# Empty on localhost: the Vite dev server proxies /v1 to SWF_API_PROXY (default 127.0.0.1:8000).
VITE_API_BASE=
# Never set this for a deployed build. "dev" enables the pasted-JWT sign-in (tests only).
# VITE_AUTH_MODE=dev
